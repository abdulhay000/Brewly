PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=xxxxxxxxxxx
DB_NAME=brewly_db

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com

# Store all prices and Telebirr payments in Ethiopian Birr.
CURRENCY=ETB

# Email (Gmail example: use a Google App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=Brewly <your-email@gmail.com>

# Telebirr merchant API credentials from the Ethio Telecom developer portal.
# Use SANDBOX while testing, then PRODUCTION for live payments.
TELEBIRR_ENVIRONMENT=SANDBOX
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_NOTIFY_URL=https://your-public-domain.com/api/payments/telebirr/notify
TELEBIRR_REDIRECT_URL=http://localhost:5173/user
